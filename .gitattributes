# Normalize line endings: store and check out text files with LF regardless of
# the local core.autocrlf setting. This stops the "LF will be replaced by CRLF"
# warnings on Windows and keeps the working tree consistent across platforms.
* text=auto eol=lf

# Common binaries: never touch line endings or diff as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.ico binary
*.zip binary
data/personamem-v2-train-v1/records.jsonl filter=lfs diff=lfs merge=lfs -text
data/retrieval-indexes/personamem-v2-train-v1/chunks.jsonl filter=lfs diff=lfs merge=lfs -text
data/retrieval-indexes/personamem-v2-train-v1/sentences.jsonl filter=lfs diff=lfs merge=lfs -text
data/retrieval-indexes/personamem-v2-train-v1/sentence_embeddings.npy filter=lfs diff=lfs merge=lfs -text
